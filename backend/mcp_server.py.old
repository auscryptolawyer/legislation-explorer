# Regex for medium-neutral case citations: [2024] HCA 1, [2020] FCAFC 135
_CASE_CITATION_RE = _re.compile(r'\[(\d{4})\]\s*([A-Z]+(?:\s*[A-Z]+)*)\s*(\d+)')


def _normalise_case_citation(raw: str) -> str | None:
    """Strip party names and normalise a case citation to bare medium-neutral form.

    Accepts:
        '[2024] HCA 1'              → '[2024] HCA 1'
        'Smith v Minister [2024] HCAFC 1'  → '[2024] HCAFC 1'
        '2020 FCAFC 135'            → None  (missing brackets)

    Returns the bare citation or *None* if the string does not contain a
    recognisable medium-neutral citation.
    """
    m = _CASE_CITATION_RE.search(raw)
    if m:
        return f"[{m.group(1)}] {m.group(2)} {m.group(3)}"
    return None


